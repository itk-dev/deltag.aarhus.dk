<!doctype html>
<html lang="da">
<head>
  <meta charset="utf-8">
  <title>{{ dialogue.label }}</title>
  <style>{{ css|raw }}</style>
</head>
<body>
  {% import _self as helpers %}
  {% set frontpage = 'Frontpage'|t({}, {context: 'Dialogue report'}) %}

  {% if not for_pdf %}
    <a class="pdf-button" href="{{ url('hoeringsportal_dialogue_report.pdf', {node: dialogue.id}) }}">{{ 'Create PDF'|t }}</a>
  {% endif %}

  <h1 id="top">{{ dialogue.label }}</h1>
  {% if dialogue.field_teaser.value %}
    <div class="teaser text">{{ dialogue.field_teaser.value }}</div>
  {% endif %}

  <section id="statistik">
    <p>{{ 'Click on a category to see all input within the subject'|t }}</p>
    <div class="card-grid">
      {% for tid, category in categories %}
        <div class="category-card" id="stat-{{ tid }}">
          <h3>{{ category.term.label }}</h3>
          <ul class="counts">
            <li>{{ helpers.icon('input') }}{{ helpers.input_count(category.proposal_count) }}</li>
            <li>{{ helpers.icon('agree') }}{{ helpers.agree_count(category.like_count) }}</li>
            <li>{{ helpers.icon('comment') }}{{ helpers.comment_count(category.comment_count) }}</li>
          </ul>
          {% if category.proposals %}
            <a class="see-all" href="#kategori-{{ tid }}">{{ 'See all input'|t }}{{ helpers.icon('forward') }}</a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <p class="info">{{ helpers.icon('info') }}{{ 'The numbers show the total input, agree votes and comments in each category.'|t }}</p>
  </section>

  {% for tid, category in categories|filter(category => category.proposals) %}
    <section class="category" id="kategori-{{ tid }}">
      {{ helpers.nav([{label: frontpage, href: '#top'}, {label: category.term.label}], '#stat-' ~ tid, frontpage) }}
      <h2>{{ category.term.label }}</h2>
      <p class="intro">{{ 'Here is all the input about @category. Click on an input to see its comments.'|t({'@category': category.term.label}) }}</p>
      <ul class="input-list">
        {% for proposal in category.proposals %}
          <li>
            <a class="input-card" href="#forslag-{{ tid }}-{{ proposal.node.id }}">
              <span class="input-card__text">
                <strong>{{ proposal.node.label }}</strong>
                <span class="excerpt">{{ proposal.node.field_dialogue_proposal_descr.value }}</span>
              </span>
              <span class="input-card__counts">
                <span>{{ helpers.icon('agree') }}{{ helpers.agree_count(proposal.like_count) }}</span>
                <span>{{ helpers.icon('comment') }}{{ helpers.comment_count(proposal.comment_count) }}</span>
              </span>
              {{ helpers.icon('chevron') }}
            </a>
          </li>
        {% endfor %}
      </ul>
      <p class="note">{{ helpers.icon('info') }}{{ 'The numbers show agree votes and comments for each input.'|t }}</p>
    </section>

    {% for proposal in category.proposals %}
      <article class="proposal" id="forslag-{{ tid }}-{{ proposal.node.id }}">
        {{ helpers.nav([{label: frontpage, href: '#top'}, {label: category.term.label, href: '#kategori-' ~ tid}, {label: proposal.node.label}], '#kategori-' ~ tid, frontpage) }}
        <h3 class="proposal-title">{{ proposal.node.label }}</h3>
        {% if proposal.category_count > 1 %}
          <p class="info">{{ helpers.icon('info') }}{{ 'Displayed multiple times'|t }}</p>
        {% endif %}
        <div class="text">{{ proposal.node.field_dialogue_proposal_descr.value }}</div>

        <div class="summary">
          <span>{{ helpers.icon('agree') }}{{ helpers.agree_count(proposal.like_count) }}</span>
          <span>{{ helpers.icon('comment') }}{{ helpers.comment_count(proposal.comment_count) }}</span>
        </div>

        {% if proposal.comments %}
          <h4>{{ 'Comments'|t }}</h4>
          {{ helpers.comment_tree(proposal.comments) }}
          <p class="note">{{ helpers.icon('info') }}{{ 'The numbers show agree votes on each comment.'|t }}</p>
        {% endif %}
      </article>
    {% endfor %}
  {% endfor %}

  {% macro icon(name) -%}
    {%- set paths = {
      back: 'M14 8H2M7 3 2 8l5 5',
      forward: 'M2 8h12M9 3l5 5-5 5',
      chevron: 'M6 3l5 5-5 5',
      home: 'M2 7.5 8 2l6 5.5M3.5 6v8h9V6M6.5 14v-4h3v4',
      info: 'M8 1.5a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13M8 7.5v3.5M8 5h.01',
      input: 'M4 1.5h5l3.5 3.5v9.5h-8.5zM9 1.5V5h3.5M6 8.5h4M6 11h4',
      agree: 'M8 1.5a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13M5.5 8l1.8 1.8 3.2-3.3',
      comment: 'M2.5 3h11v7.5h-6.5l-3 2.5v-2.5h-1.5z',
    } -%}
    <svg class="icon icon--{{ name }}" viewBox="0 0 16 16" aria-hidden="true"><path d="{{ paths[name] }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- endmacro %}

  {% macro input_count(count) -%}
    {% trans %}1 input{% plural count %}{{ count }} inputs{% endtrans %}
  {%- endmacro %}

  {% macro agree_count(count) -%}
    {% trans %}1 agree vote{% plural count %}{{ count }} agree votes{% endtrans %}
  {%- endmacro %}

  {% macro comment_count(count) -%}
    {% trans %}1 comment{% plural count %}{{ count }} comments{% endtrans %}
  {%- endmacro %}

  {% macro icon_link(href, icon, label) %}
    <a class="icon-link" href="{{ href }}">{{ _self.icon(icon) }}{{ label }}</a>
  {% endmacro %}

  {# Breadcrumb trail on the left, home and back links on the right. #}
  {% macro nav(trail, back_href, frontpage) %}
    <nav class="report-nav">
      <ol class="breadcrumb">
        {% for item in trail %}
          <li>
            {% if item.href is defined %}
              <a href="{{ item.href }}">{{ item.label }}</a>
            {% else %}
              {{ item.label }}
            {% endif %}
          </li>
        {% endfor %}
      </ol>
      <span class="nav-links">
        {{ _self.icon_link('#top', 'home', frontpage) }}
        {{ _self.icon_link(back_href, 'back', 'Back'|t) }}
      </span>
    </nav>
  {% endmacro %}

  {% macro comment_tree(entries) %}
    <ul class="comment-list">
      {% for entry in entries %}
        <li>
          <div class="comment-card">
            <div class="text">{{ entry.comment.field_comment.value }}</div>
            <div class="comment-card__agree">{{ _self.icon('agree') }}{{ _self.agree_count(entry.like_count) }}</div>
          </div>
          {% if entry.children %}
            {{ _self.comment_tree(entry.children) }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endmacro %}
</body>
</html>
