<!doctype html>
<html lang="da">
<head>
  <meta charset="utf-8">
  <title>{{ dialogue.label }}</title>
  <style>{{ css|raw }}</style>
</head>
<body>
  {% if not for_pdf %}
    <a class="pdf-button" href="{{ url('hoeringsportal_dialogue_report.pdf', {node: dialogue.id}) }}">{{ 'Create PDF'|t }}</a>
  {% endif %}
  <h1 id="top">{{ dialogue.label }}</h1>
  {% if dialogue.field_teaser.value %}
    <div class="teaser text">{{ dialogue.field_teaser.value }}</div>
  {% endif %}

  <section id="statistik">
    <h2>{{ 'Statistics'|t }}</h2>
    <div class="stat-grid">
      {% for tid, category in categories %}
        <div class="stat-box" id="stat-{{ tid }}">
          <h3>
            {% if category.proposals %}
              <a href="#toc-{{ tid }}">{{ category.term.label }}</a>
            {% else %}
              {{ category.term.label }}
            {% endif %}
          </h3>
          <dl>
            <dt>{{ 'Proposals'|t }}</dt><dd>{{ category.proposal_count }}</dd>
            <dt>{{ 'Likes'|t }}</dt><dd>{{ category.like_count }}</dd>
            <dt>{{ 'Comments'|t }}</dt><dd>{{ category.comment_count }}</dd>
          </dl>
        </div>
      {% endfor %}
    </div>
  </section>

  <section id="indholdsfortegnelse">
    <h2>{{ 'Table of contents'|t }}</h2>
    {% for tid, category in categories|filter(category => category.proposals) %}
      <div class="toc-box" id="toc-{{ tid }}">
        <h3>
          {{ category.term.label }}
          &mdash; <a href="#top">{{ 'To top'|t }}</a>
          &middot; <a href="#stat-{{ tid }}">{{ 'To statistics'|t }}</a>
        </h3>
        <ul>
          {% for proposal in category.proposals %}
            <li>
              <a href="#forslag-{{ proposal.node.id }}">{{ proposal.node.label }}</a>
              &mdash; {{ 'Likes'|t }}: {{ proposal.like_count }}, {{ 'Comments'|t }}: {{ proposal.comment_count }}
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </section>

  <section id="forslag">
    <h2>{{ 'Proposals'|t }}</h2>
    {% import _self as helpers %}
    {% for tid, category in categories %}
      {% for proposal in category.proposals %}
        <article class="proposal" id="forslag-{{ proposal.node.id }}">
          <h3>{{ proposal.node.label }}</h3>
          <p>
            <a href="#top">{{ 'To top'|t }}</a>
            &middot; <a href="#toc-{{ tid }}">{{ 'To table of contents'|t }} ({{ category.term.label }})</a>
          </p>
          <div class="text">{{ proposal.node.field_dialogue_proposal_descr.value }}</div>
          <p>{{ 'Likes'|t }}: {{ proposal.like_count }} &middot; {{ 'Comments'|t }}: {{ proposal.comment_count }}</p>

          {% if proposal.comments %}
            <div class="comments">
              {{ helpers.comment_tree(proposal.comments) }}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    {% endfor %}
  </section>

  {% macro comment_tree(entries) %}
    <ul>
      {% for entry in entries %}
        <li class="comment">
          <strong>{{ entry.comment.authorName }}</strong>
          &mdash; {{ entry.comment.created.value|date('d-m-Y H:i') }}
          &mdash; {{ 'Likes'|t }}: {{ entry.like_count }}
          <div class="text">{{ entry.comment.field_comment.value }}</div>
          {% if entry.children %}
            {{ _self.comment_tree(entry.children) }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endmacro %}
</body>
</html>
