parameters:
  paths:
    - web/modules/custom
  excludePaths:
    - web/modules/custom/hoeringsportal_deskpro/node_modules (?) # optional path, might not exist
  level: 0
  customRulesetUsed: true
  ignoreErrors:
      - '#\Drupal calls should be avoided in classes, use dependency injection instead#'
      - '#Attribute class Drupal\\Core\\Hook\\Attribute\\Hook does not exist.#'
      - '#Attribute class Drupal\\Core\\Hook\\Attribute\\LegacyHook does not exist.#'
      - '#Missing cache backend declaration for performance.#'
      - '#Plugin manager has cache backend specified but does not declare cache tags.#'
  reportUnmatchedIgnoredErrors: false
